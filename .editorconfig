root = true

[*]
indent_size          = 4
indent_style         = tab
tab_width            = 4
end_of_line          = crlf
insert_final_newline = true
charset              = utf-8

[*.sh]
end_of_line = lf

[*.{yml,yaml}]
indent_size  = 2
indent_style = space
tab_width    = 2
end_of_line  = lf

[*.{bat,cmd}]
charset = unset
